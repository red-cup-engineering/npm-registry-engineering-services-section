{
  "name": "@red-cup-engineering/npm-registry-user-service",
  "version": "0.1.1",
  "description": "Manages the private registry's htpasswd users: list, add ({SHA} scheme, dependency-free), verify, and remove — independent of Verdaccio's max_users signup gate.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/npm-registry-engineering-services-section.git",
    "directory": "services/npm-registry-user-service"
  },
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "package.json",
    "examples/quickstart.test.mjs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "manage-registry-user": "./scripts/manage-registry-user.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts",
    "test:consumer": "node --test examples/quickstart.test.mjs"
  },
  "main": "./src/index.mjs",
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  },
  "engines": {
    "node": ">=22"
  }
}
