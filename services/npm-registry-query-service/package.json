{
  "name": "@red-cup-engineering/npm-registry-query-service",
  "version": "0.3.1",
  "description": "Answers whether a package exists in a built or live npm registry, searches package names, and reads direct dependencies, dependents, and standard package interfaces without deriving a whole graph.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/npm-registry-engineering-services-section.git",
    "directory": "services/npm-registry-query-service"
  },
  "type": "module",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/query-npm-registry.mjs",
    "./obtain-registry-snapshot": "./src/obtain-registry-snapshot.mjs"
  },
  "bin": {
    "query-npm-registry": "./scripts/query-npm-registry.mjs"
  },
  "files": [
    "src",
    "scripts",
    "package.json"
  ],
  "scripts": {
    "test": "run-package-tests",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts",
    "check": "check-package-syntax"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/cryptographic-computer-data-engineering-services-section": "0.3.1",
    "@red-cup-engineering/npm-registry-engineering-services-section": "0.1.2"
  },
  "devDependencies": {
    "@red-cup-engineering/jsnode-package-engineering-services-section": "0.3.0"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
