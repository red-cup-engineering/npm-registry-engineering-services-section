ter-triplet-serialized-content-engineering-services-section":"0.1.6-dev.133"},"bin":{"compile-translation-lexicons":"scripts/compile-translation-lexicons.mjs"},"private":false,"files":["package.json","README*","LICENSE*","scripts","src","apps","!apps/arabic-language-corpus/**","!apps/english-language-corpus/**","!apps/horsetail/**","!apps/lakota-language-corpus/**","!apps/latin-language-corpus/**","!apps/panini/**","!apps/relation-language-corpus/**","!apps/tokipona-language-corpus/**","data/translation-lexicons/cdrama-subtitles.json","test/translation-memory-tmx.test.mjs","test/translation-memory-tmx-boundaries.test.mjs"],"license":"MIT","funding":{"type":"individual","url":"https://github.com/561-group/.github/blob/main/TIPS.md"},"scripts":{"test:source-projection":"node --test test/source-anchoring.test.mjs","test:tag-native":"node --test test/tag-native-source.test.mjs","test:tmx":"node --test test/translation-memory-tmx*.test.mjs"},"receivingTests":["test/translation-memory-tmx.test.mjs","test/translation-memory-tmx-boundaries.test.mjs"],"readme":"# @red-cup-engineering/computer-language-systems-engineering-services-section\n\n<!-- 561-group-standards:badges:start -->\n[![Red Cup Engineering](https://img.shields.io/badge/561%20Group-Red%20Cup%20Engineering-c0392b)](https://github.com/red-cup-engineering)\n[![License: MIT](https://img.shields.io/badge/license-MIT-c0392b)](LICENSE)\n[![Indigenous data: CARE](https://img.shields.io/badge/Indigenous%20data-CARE-4b6f44)](https://github.com/red-cup-engineering/.github/blob/main/GOVERNANCE.md)\n[![Tips welcome](https://img.shields.io/badge/tips-welcome-d4a017)](https://github.com/561-group/.github/blob/main/TIPS.md)\n<!-- 561-group-standards:badges:end -->\n\nComputer language systems engineering: grammars, parsers, and language tooling, including Panini.\n\n\n## Source-exact language reading projection\n\nThe shared `./tag` interface consumes the real communicating provider's\narticulated word spans and settled sentence spans. It attaches original-document\nUTF-16 half-open `sourceSpan` and parallel `wordSourceSpans` to each\n`tagText` sentence **only when the native articulation and parsed words agree\nexactly** on source bytes, occurrence order and boundaries. Duplicate words\nand duplicate sentence strings retain distinct positions. The existing\n`words`, `arcs`, `roles`, `tower` and `cohomology` projections are\nunchanged.\n\nOn a mismatch, `sourceBinding: \"withheld\"` and a bounded\n`sourceBindingReason` accompany null token spans. Consumers must **not**\nreplace missing coordinates with invented first-occurrence search results,\nnor infer factual truth, permission or interpretation authority from syntax.\nA `native-exact` binding establishes source byte correspondence only.\n\nRun `npm run test:source-projection` for dependency-free source-binding\nregressions. Run `npm run test:tag-native` in a checkout with the original\nEnglish-language-algebra Git submodule and exact installed communicating\ndependencies to test genuine articulation→settlement→tagging end-to-end.\nIsolated projection tests cannot substitute for that provider-qualified\nintegration or downstream receiving.\n","readmeFilename":"README.md","gitHead":"240b9f958e2bf0d97067559a3e8568cd037604fc","_id":"@red-cup-engineering/computer-language-systems-engineering-services-section@0.1.4-dev.2","bugs":{"url":"https://github.com/red-cup-engineering/computer-language-systems-engineering-services-section/issues"},"homepage":"https://github.com/red-cup-engineering/computer-language-systems-engineering-services-section#readme","_nodeVersion":"24.18.0","_npmVersion":"11.16.0","dist":{"integrity":"sha512-WPLkuZAYmtGaRRaDh1V03QqinhqoN2m0CgyB14blm95EGqmthpQiODhj8X7hqpv1yDAqXNizcYIKSvYmX5E7xA==","shasum":"ad1b19fc7e436610d84cb11786735f38f2297fcb","tarball":"https://registry.561.group/@red-cup-engineering/computer-language-systems-engineering-services-section/-/computer-language-systems-engineering-services-section-0.1.4-d