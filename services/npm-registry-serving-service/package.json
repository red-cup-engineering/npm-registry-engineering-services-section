{
  "name": "@red-cup-engineering/npm-registry-serving-service",
  "version": "0.2.5",
  "private": false,
  "type": "module",
  "description": "Serves the house's npm packages natively from their facts: an append-only journal per package and its tarballs by RFC 6920 NI address, projected to the npm registry protocol npm and pnpm speak (conditional requests, login tokens, search, audit), standalone or as a MetroPlat hosted application. Reads every published version statically and refuses one whose files, dependencies and imports do not hold together.",
  "exports": {
    ".": "./src/registry.mjs",
    "./application": "./src/application.mjs",
    "./prepared-publication": "./src/prepared-publication.mjs",
    "./facts": "./src/facts.mjs",
    "./projection": "./src/projection.mjs",
    "./store": "./src/store.mjs",
    "./reception": "./src/reception.mjs",
    "./r2-registry": "./src/r2-registry.mjs",
    "./peers": "./src/peers.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/computer-content-address-engineering-services-section": "0.2.1",
    "@red-cup-engineering/javascript-parser-service": "0.1.0",
    "@red-cup-engineering/uri-services-section": "0.1.3",
    "bcryptjs": "2.4.3",
    "semver": "7.7.2",
    "@red-cup-engineering/json-services-section": "0.4.1",
    "@red-cup-engineering/cloudflare-r2-services-section": "0.7.1"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:legacy-r2-publication": "node --test test/integration/legacy-r2-publication-admission.test.mjs",
    "test:landed-registry-port": "node --test test/integration/landed-registry-port.test.mjs"
  },
  "receivingTests": [
    "test/registry-receiving.test.mjs",
    "test/prepared-publication.test.mjs",
    "test/packed-maintenance-script.test.mjs",
    "test/publish-gate.test.mjs",
