    "repair-scoped-publication-artifact": "./bin/repair-scoped-publication-artifact.mjs",
    "receive-registry-store": "./bin/receive-store.mjs",
    "serve-r2-publisher": "./bin/serve-r2-publisher.mjs",
    "receive-from-peers": "./bin/receive-from-peers.mjs",
    "admit-publisher": "./bin/admit-publisher.mjs",
    "carry-held-to-canonical": "./bin/carry-held-to-canonical.mjs"
  },
