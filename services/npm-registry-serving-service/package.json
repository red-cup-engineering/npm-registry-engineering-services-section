    "test/tarball-reader.test.mjs",
    "test/package-exports.test.mjs",
    "test/facts-store.test.mjs",
    "test/protocol.test.mjs",
    "test/clients.test.mjs",
    "test/leftovers.test.mjs",
    "test/memory-bounds.test.mjs",
    "test/public-tarballs.test.mjs",
    "test/r2-registry.test.mjs",
